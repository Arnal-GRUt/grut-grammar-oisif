---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
// import ArtCard from "../components/ArtCard.astro";

const pageTitle = "Gribouille";
// const allArts = (await getCollection("grutArt")).sort(
// 	(a, b) => Date.parse(b.data.img_date) - Date.parse(a.data.img_date),
// );
// const allArts = await getCollection("grutArt");
const allArts = (await getCollection("grutArt")).sort((a, b) => b.id - a.id);
---

<BaseLayout pageTitle={pageTitle}>
	<div class="galerie display-flex">
		<div class="colonne-image">
			{
				allArts.map((art) => (
					<div class="image cards">
						<div class="figure flow">
							<button
								class="image-button"
								popovertarget={`grib-${art.id}`}
								popovertargetaction="show"
							>
								<Image
									src={art.data.image.source}
									alt={art.data.image.img_alt}
									width="1200"
									height="400"
								/>
								<div class="figcaption">
									{art.data.img_name}
								</div>
							</button>
						</div>
						<dialog
							popover
							class="image-lightbox"
							id={`grib-${art.id}`}
						>
							<div class="image-lightbox--img">
								<Image
									src={art.data.image.source}
									alt={art.data.image.img_alt}
									width="1200"
									height="400"
								/>
								<button
									popovertarget={`grib-${art.id}`}
									popovertargetaction="hide"
									class="close-btn"
								>
									X
								</button>
							</div>
						</dialog>
					</div>
				))
			}
		</div>
	</div>
</BaseLayout>
<style>
	.image-lightbox--img {
		position: relative;
		display: flex;
		/* height: fit-content; */
		height: calc(100% + 80px);
		top: 45%;
		overflow

		& button.close-btn {
			border-radius: 100%;
			background: var(--grut-color);
			color: var(--defaut-txt);
			position: fixed;
			width: 32px;
			height: 32px;
			font-size: 24px;
			border: 2px solid var(--defaut-txt);
			padding: 0;
			display: flex;
			align-items: center;
			justify-content: center;
		}
	}
</style>
